# Copy to .env and edit for this PC. Command-line overrides take precedence.
# This file uses Make assignment syntax. Leave values unquoted.
# Values may contain spaces. Escape a literal # as \# and a literal $ as $$.
# Keep the directory running before starting peers.

# Python 3.12 executable, used by make setup.
PYTHON=python3.12
VENV=.venv

# Peer identity and network settings.
ID=peer1
IP=127.0.0.1
BIND=0.0.0.0
PORT=8101

# On every PC, set this to the directory PC's reachable LAN or VPN address.
DIRECTORY_IP=127.0.0.1
DIRECTORY_PORT=8080

# 0.5 MiB/s per request makes failure injection easier. Set 0 for no cap.
RATE=0.5
VERBOSE=1
INTERACTIVE=1

# Optional overrides. Defaults below are derived from the settings above.
# DIRECTORY_URL=http://$(DIRECTORY_IP):$(DIRECTORY_PORT)
# ADVERTISE=http://$(IP):$(PORT)
# STATE=run/manual/$(ID)
# DB=run/manual/directory.sqlite3
# LOG=run/manual/$(ID).log

# Set to a chunk index only for the corruption test. Empty disables corruption.
CORRUPT_INDEX=
